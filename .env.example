# Скопируйте в .env на сервере (или локально для Docker): cp .env.example .env
# Файл .env не коммитьте — в .gitignore.

# --- Публичные (учитываются при сборке образа web; после смены пересоберите: docker compose build web) ---
NEXT_PUBLIC_SITE_URL=https://ваш-домен.by
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Заявки с формы (серверные, подставляются в контейнер при старте) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Исходящий HTTP-прокси только для Bot API (если api.telegram.org с VPS недоступен, напр. в РФ):
# TELEGRAM_HTTP_PROXY=http://user:pass@proxy.example.com:3128
# Либо Proxifly API (https://proxifly.dev — ключ снимает лимиты):
# TELEGRAM_USE_PROXIFLY=true
# PROXIFLY_API_KEY=
# PROXIFLY_PROXY_COUNTRY=DE

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Опционально: Telegram Admin Bot (профиль admin, см. README) ---
# TELEGRAM_ADMIN_CHAT_ID=
# Если не задан, для админ-бота используется TELEGRAM_CHAT_ID
