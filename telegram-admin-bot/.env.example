# Токен бота (тот же, что для заявок с сайта, или новый бот через @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAF-xxx

# Chat ID администраторов (несколько ID через запятую)
# Узнать: напишите боту /start → откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321

# Chat ID для заявок с сайта (можно несколько)
TELEGRAM_CHAT_IDS=123456789,-1001234567890

# Путь к проекту на сервере (где git и package.json)
APP_DIR=/var/www/ValikLanding

# Имя приложения в PM2 (или "all" для перезапуска всех)
PM2_APP_NAME=all

# Скрипт сборки: build или build:dev
BUILD_SCRIPT=build
